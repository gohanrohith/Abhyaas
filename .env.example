# Copy to .env and fill in values

PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=abhyaas_db
DB_USER=root
DB_PASS=

# Session
SESSION_SECRET=change-this-to-a-long-random-string

# Domain
MAIN_DOMAIN=abhyaastheglobalschool.com

# Email (Hostinger SMTP)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USER=office@abhyaastheglobalschool.com
MAIL_PASS=
MAIL_FROM=Abhyaas The Global School <office@abhyaastheglobalschool.com>

# Uploads directory (set to absolute path OUTSIDE project on production)
# Example: UPLOADS_DIR=/home/u123456789/abhyaas-uploads
UPLOADS_DIR=

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
