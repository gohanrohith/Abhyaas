<section class="page-hero">
  <div class="container">
    <h1><%= category ? (category.charAt(0).toUpperCase()+category.slice(1))+'s' : 'Blog' %></h1>
    <p>News, stories, and updates from Abhyaas</p>
    <p class="breadcrumb"><a href="/">Home</a> <span>›</span> <% if (category) { %><a href="/blog">Blog</a> <span>›</span> <%= category.charAt(0).toUpperCase()+category.slice(1) %><% } else { %>Blog<% } %></p>
  </div>
</section>

<section class="section">
  <div class="container">

    <!-- Category Filter -->
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:40px;justify-content:center">
      <a href="/blog" style="padding:8px 20px;border-radius:20px;font-size:.85rem;font-weight:600;border:1.5px solid <%= !category ? 'var(--green)' : 'var(--gray-200)' %>;background:<%= !category ? 'var(--green)' : 'transparent' %>;color:<%= !category ? 'var(--white)' : 'var(--gray-700)' %>">All</a>
      <% ['news','article','achievement'].forEach(function(cat) { %>
      <a href="/blog/category/<%= cat %>" style="padding:8px 20px;border-radius:20px;font-size:.85rem;font-weight:600;border:1.5px solid <%= category===cat ? 'var(--green)' : 'var(--gray-200)' %>;background:<%= category===cat ? 'var(--green)' : 'transparent' %>;color:<%= category===cat ? 'var(--white)' : 'var(--gray-700)' %>">
        <%= cat.charAt(0).toUpperCase()+cat.slice(1)+'s' %>
      </a>
      <% }) %>
    </div>

    <% if (posts.length > 0) { %>
    <div class="blog-cards">
      <% posts.forEach(function(post) { %>
      <article class="blog-card">
        <% if (post.cover_image) { %>
        <a href="/blog/<%= post.slug %>" class="blog-card-img">
          <img src="/uploads/blog/<%= post.cover_image %>" alt="<%= post.title %>" loading="lazy">
        </a>
        <% } else { %>
        <div style="height:160px;background:var(--navy-10);display:flex;align-items:center;justify-content:center">
          <i class="fa fa-newspaper" style="font-size:2rem;color:var(--navy);opacity:.2"></i>
        </div>
        <% } %>
        <div class="blog-card-body">
          <span class="blog-cat blog-cat-<%= post.category %>"><%= post.category %></span>
          <h3><a href="/blog/<%= post.slug %>"><%= post.title %></a></h3>
          <% if (post.excerpt) { %><p class="blog-excerpt"><%= post.excerpt.slice(0,110) %>…</p><% } %>
          <span class="blog-date"><i class="fa fa-calendar-alt"></i>
            <%= new Date(post.published_at).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %>
          </span>
        </div>
      </article>
      <% }) %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
    <div style="display:flex;justify-content:center;gap:8px;margin-top:48px">
      <% if (page > 1) { %>
        <a href="?page=<%= page-1 %>" style="padding:8px 16px;border:1px solid var(--gray-200);border-radius:var(--radius);font-size:.875rem;color:var(--gray-700)">← Prev</a>
      <% } %>
      <% for (let i=1; i<=totalPages; i++) { %>
        <a href="?page=<%= i %>" style="padding:8px 16px;border:1px solid <%= i===page ? 'var(--green)' : 'var(--gray-200)' %>;border-radius:var(--radius);font-size:.875rem;background:<%= i===page ? 'var(--green)' : 'transparent' %>;color:<%= i===page ? 'var(--white)' : 'var(--gray-700)' %>"><%= i %></a>
      <% } %>
      <% if (page < totalPages) { %>
        <a href="?page=<%= page+1 %>" style="padding:8px 16px;border:1px solid var(--gray-200);border-radius:var(--radius);font-size:.875rem;color:var(--gray-700)">Next →</a>
      <% } %>
    </div>
    <% } %>

    <% } else { %>
    <div style="text-align:center;padding:80px 0;color:var(--gray-500)">
      <i class="fa fa-newspaper" style="font-size:3rem;opacity:.2;display:block;margin-bottom:16px"></i>
      <p>No posts published yet. Check back soon!</p>
    </div>
    <% } %>
  </div>
</section>
