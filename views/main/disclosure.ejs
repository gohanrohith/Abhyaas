<section class="page-hero">
  <div class="container">
    <h1>CBSE Mandatory Public Disclosure</h1>
    <p>Transparency in compliance — as mandated by CBSE</p>
    <p class="breadcrumb"><a href="/">Home</a> <span>›</span> Disclosure</p>
  </div>
</section>

<section class="section">
  <div class="disclosure-section">

    <!-- General Info -->
    <div style="background:var(--offwhite);border-radius:var(--radius-lg);padding:32px;margin-bottom:40px">
      <h2 style="color:var(--navy);margin-bottom:20px;font-size:1.2rem">General Information</h2>
      <table class="disclosure-table">
        <tr><td style="width:40%;font-weight:600;color:var(--gray-700)">Name of the School</td><td><%= school.name %></td></tr>
        <tr><td style="font-weight:600;color:var(--gray-700)">Affiliation Number</td><td><%= school.affiliation || 'To be updated' %></td></tr>
        <tr><td style="font-weight:600;color:var(--gray-700)">School Code</td><td><%= school.schoolCode || 'To be updated' %></td></tr>
        <tr><td style="font-weight:600;color:var(--gray-700)">Address</td><td><%= school.address %></td></tr>
        <tr><td style="font-weight:600;color:var(--gray-700)">Principal</td><td><%= school.principal.name || 'To be updated' %></td></tr>
        <tr><td style="font-weight:600;color:var(--gray-700)">Phone</td><td><%= school.phone || 'To be updated' %></td></tr>
        <tr><td style="font-weight:600;color:var(--gray-700)">Email</td><td><%= school.email %></td></tr>
        <tr><td style="font-weight:600;color:var(--gray-700)">Year of Establishment</td><td><%= school.established %></td></tr>
        <tr><td style="font-weight:600;color:var(--gray-700)">Board of Affiliation</td><td>CBSE, New Delhi</td></tr>
        <tr><td style="font-weight:600;color:var(--gray-700)">Classes</td><td><%= school.grades %></td></tr>
        <tr><td style="font-weight:600;color:var(--gray-700)">Medium of Instruction</td><td>English</td></tr>
      </table>
    </div>

    <!-- Documents -->
    <% const docTypes = [
      {key:'affiliation', label:'Affiliation Certificate'},
      {key:'noc', label:'No Objection Certificate (NOC) from State Govt.'},
      {key:'recognition', label:'Recognition Certificate'},
      {key:'building_safety', label:'Building Safety Certificate'},
      {key:'fire_safety', label:'Fire Safety Certificate'},
      {key:'deo', label:'DEO / BEO Certificate'},
      {key:'self_certification', label:'Self Certification by Manager / Secretary'},
      {key:'smc', label:'School Managing Committee (SMC)'},
      {key:'pta', label:'Parent Teacher Association (PTA)'},
      {key:'fee_structure', label:'Fee Structure'},
      {key:'annual_report', label:'Annual Academic Calendar / Report'},
      {key:'tc_proforma', label:'Transfer Certificate Proforma'},
    ];
    %>
    <h2 style="color:var(--navy);margin-bottom:20px;font-size:1.2rem">Documents & Certificates</h2>
    <% if (docs && docs.length > 0) { %>
    <table class="disclosure-table" style="margin-bottom:40px">
      <thead>
        <tr>
          <th>#</th>
          <th>Document</th>
          <th>Year</th>
          <th>Download</th>
        </tr>
      </thead>
      <tbody>
        <% docs.forEach(function(doc, i) { %>
        <tr>
          <td><%= i+1 %></td>
          <td><%= doc.label %></td>
          <td><%= doc.year || '—' %></td>
          <td>
            <a href="/uploads/compliance/<%= doc.filename %>" class="doc-download" target="_blank">
              <i class="fa fa-download"></i> Download
            </a>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } else { %>
    <div style="padding:32px;background:var(--offwhite);border-radius:var(--radius);text-align:center;margin-bottom:40px;color:var(--gray-500)">
      <i class="fa fa-file-circle-plus" style="font-size:2rem;opacity:.3;margin-bottom:12px;display:block"></i>
      <p>Compliance documents will be uploaded shortly.</p>
    </div>
    <% } %>

    <div style="padding:20px;background:rgba(41,34,117,.05);border-radius:var(--radius);border-left:4px solid var(--navy)">
      <p style="color:var(--gray-700);font-size:.875rem"><strong>Note:</strong> This page is maintained in compliance with CBSE mandatory public disclosure requirements. For any queries related to these documents, please contact the school office at <a href="mailto:<%= school.email %>" style="color:var(--green)"><%= school.email %></a>.</p>
    </div>
  </div>
</section>
