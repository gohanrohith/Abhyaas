<% extraHead = `<meta property="og:type" content="article">
<meta property="og:title" content="${post.title}">
<meta property="og:description" content="${post.excerpt || ''}">
<meta property="og:url" content="${canonicalUrl}">
<meta property="og:image" content="${ogImage}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="${post.title}">
<meta name="twitter:description" content="${post.excerpt || ''}">
<meta name="twitter:image" content="${ogImage}">
<style>
.gt-article-gallery{margin:2rem 0;border:1px solid var(--gray-200);border-radius:var(--radius-lg);overflow:hidden}
.gt-article-gallery-header{padding:.6rem 1rem;font-size:.84rem;font-weight:700;background:var(--gray-50,#f9fafb);border-bottom:1px solid var(--gray-200)}
.gt-bento-gallery{padding:6px}
.gt-bento-grid{display:grid;gap:5px}
.gt-bento-grid[data-sq="0"]{grid-template-columns:1fr;grid-template-rows:320px}
.gt-bento-grid[data-sq="1"]{grid-template-columns:2fr 1fr;grid-template-rows:320px}
.gt-bento-grid[data-sq="2"]{grid-template-columns:2fr 1fr;grid-template-rows:162px 162px}
.gt-bento-grid[data-sq="3"],.gt-bento-grid[data-sq="4"]{grid-template-columns:2fr 1fr 1fr;grid-template-rows:162px 162px}
.gt-bento-big{border-radius:5px;overflow:hidden;cursor:pointer;grid-column:1}
.gt-bento-grid[data-sq="0"] .gt-bento-big,.gt-bento-grid[data-sq="1"] .gt-bento-big{grid-row:1}
.gt-bento-grid[data-sq="2"] .gt-bento-big,.gt-bento-grid[data-sq="3"] .gt-bento-big,.gt-bento-grid[data-sq="4"] .gt-bento-big{grid-row:1/3}
.gt-bento-sq{position:relative;border-radius:5px;overflow:hidden;cursor:pointer}
.gt-bento-sq-1{grid-column:2;grid-row:1}.gt-bento-sq-2{grid-column:2;grid-row:2}
.gt-bento-sq-3{grid-column:3;grid-row:1}.gt-bento-sq-4{grid-column:3;grid-row:2}
.gt-bento-big img,.gt-bento-sq img{width:100%;height:100%;object-fit:cover;display:block}
.gt-bento-more{position:absolute;inset:0;background:rgba(0,0,0,.56);display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.4rem;font-weight:800;pointer-events:none}
@media(max-width:560px){
  .gt-bento-grid[data-sq="1"],.gt-bento-grid[data-sq="2"],.gt-bento-grid[data-sq="3"],.gt-bento-grid[data-sq="4"]{grid-template-columns:1fr 1fr;grid-template-rows:150px 105px 105px}
  .gt-bento-big{grid-column:1/3;grid-row:1}
  .gt-bento-sq-1{grid-column:1;grid-row:2}.gt-bento-sq-2{grid-column:2;grid-row:2}
  .gt-bento-sq-3{grid-column:1;grid-row:3}.gt-bento-sq-4{grid-column:2;grid-row:3}
}
#ab-lightbox{display:none;position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:9999;align-items:center;justify-content:center;flex-direction:column}
#ab-lightbox.open{display:flex}
#ab-lightbox img{max-width:90vw;max-height:82vh;object-fit:contain;border-radius:6px}
#ab-lightbox .lb-cap{color:#ddd;font-size:.85rem;margin-top:.6rem;text-align:center}
#ab-lightbox .lb-close{position:absolute;top:18px;right:22px;background:none;border:none;color:#fff;font-size:2rem;cursor:pointer;line-height:1}
#ab-lightbox .lb-prev,#ab-lightbox .lb-next{position:absolute;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.15);border:none;color:#fff;font-size:1.5rem;padding:.5rem .9rem;cursor:pointer;border-radius:4px}
#ab-lightbox .lb-prev{left:12px}#ab-lightbox .lb-next{right:12px}
</style>` %>

<section class="page-hero" style="padding:48px 0 32px">
  <div class="container" style="max-width:820px">
    <span class="blog-cat blog-cat-<%= post.category %>" style="margin-bottom:12px;display:inline-block"><%= post.category %></span>
    <h1 style="font-size:clamp(1.5rem,4vw,2.2rem);line-height:1.2;margin-bottom:12px"><%= post.title %></h1>
    <div class="post-meta">
      <span><i class="fa fa-calendar-alt"></i> <%= new Date(post.published_at).toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'}) %></span>
      <span><i class="fa fa-eye"></i> <%= post.views %> views</span>
    </div>
    <p class="breadcrumb" style="margin-top:0"><a href="/">Home</a> <span>›</span> <a href="/blog">Blog</a> <span>›</span> <%= post.title.slice(0,40) %>…</p>
  </div>
</section>

<div class="post-layout">
  <article class="post-content">
    <% if (post.cover_image) { %>
    <img src="/uploads/blog/<%= post.cover_image %>" alt="<%= post.title %>" class="post-cover" onerror="this.style.display='none'">
    <% } %>
    <% if (post.content_hi || post.content_te) { %>
    <div style="display:flex;gap:0;border-bottom:2px solid var(--gray-200);margin-bottom:1.25rem">
      <button type="button" class="lang-btn active" data-lang="en"
        style="padding:.45rem 1rem;font-size:.82rem;font-weight:600;border:none;background:none;cursor:pointer;color:var(--green);border-bottom:2px solid var(--green);margin-bottom:-2px">English</button>
      <% if (post.content_hi) { %>
      <button type="button" class="lang-btn" data-lang="hi"
        style="padding:.45rem 1rem;font-size:.82rem;font-weight:600;border:none;background:none;cursor:pointer;color:var(--gray-500);border-bottom:2px solid transparent;margin-bottom:-2px">हिंदी</button>
      <% } %>
      <% if (post.content_te) { %>
      <button type="button" class="lang-btn" data-lang="te"
        style="padding:.45rem 1rem;font-size:.82rem;font-weight:600;border:none;background:none;cursor:pointer;color:var(--gray-500);border-bottom:2px solid transparent;margin-bottom:-2px">తెలుగు</button>
      <% } %>
    </div>
    <% } %>
    <div class="post-body" id="content-en"><%- post.content || '<p>Content coming soon.</p>' %></div>
    <% if (post.content_hi) { %>
    <div class="post-body" id="content-hi" style="display:none"><%- post.content_hi %></div>
    <% } %>
    <% if (post.content_te) { %>
    <div class="post-body" id="content-te" style="display:none"><%- post.content_te %></div>
    <% } %>

    <!-- Share -->
    <div style="margin-top:40px;padding-top:24px;border-top:1px solid var(--gray-200)">
      <p style="font-size:.875rem;font-weight:600;color:var(--navy);margin-bottom:12px">Share this post</p>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <a href="https://wa.me/?text=<%= encodeURIComponent(post.title+' — '+canonicalUrl) %>" target="_blank" style="padding:8px 16px;background:#25d366;color:#fff;border-radius:var(--radius);font-size:.85rem;font-weight:500;display:inline-flex;align-items:center;gap:6px"><i class="fab fa-whatsapp"></i> WhatsApp</a>
        <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(canonicalUrl) %>" target="_blank" style="padding:8px 16px;background:#1877f2;color:#fff;border-radius:var(--radius);font-size:.85rem;font-weight:500;display:inline-flex;align-items:center;gap:6px"><i class="fab fa-facebook-f"></i> Facebook</a>
      </div>
    </div>
  </article>

  <!-- Sidebar -->
  <aside class="post-sidebar">
    <% if (related.length > 0) { %>
    <h3>Related Posts</h3>
    <div style="display:flex;flex-direction:column;gap:16px">
      <% related.forEach(function(r) { %>
      <a href="/blog/<%= r.slug %>" style="display:flex;gap:12px;align-items:flex-start;text-decoration:none">
        <% if (r.cover_image) { %>
        <img src="/uploads/blog/<%= r.cover_image %>" alt="<%= r.title %>" style="width:72px;height:56px;object-fit:cover;border-radius:var(--radius);flex-shrink:0">
        <% } %>
        <div>
          <p style="font-size:.85rem;font-weight:600;color:var(--navy);line-height:1.4;margin-bottom:4px"><%= r.title %></p>
          <span style="font-size:.75rem;color:var(--gray-500)"><%= new Date(r.published_at).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) %></span>
        </div>
      </a>
      <% }) %>
    </div>
    <% } %>

    <div style="margin-top:32px;background:var(--navy);border-radius:var(--radius-lg);padding:24px;color:var(--white);text-align:center">
      <p style="font-size:.85rem;opacity:.75;margin-bottom:12px">Interested in Admissions?</p>
      <a href="/admissions" class="btn btn-orange" style="font-size:.85rem;padding:10px 20px">Enquire Now</a>
    </div>
  </aside>
</div>
<div id="ab-lightbox">
  <button class="lb-close" id="abLbClose">&times;</button>
  <button class="lb-prev" id="abLbPrev">&#8249;</button>
  <img id="abLbImg" src="" alt="">
  <p class="lb-cap" id="abLbCap"></p>
  <button class="lb-next" id="abLbNext">&#8250;</button>
</div>
<script>
(function(){
  var lb=document.getElementById('ab-lightbox');
  var lbImg=document.getElementById('abLbImg');
  var lbCap=document.getElementById('abLbCap');
  var lbData=[],cur=0;
  function showPhoto(){var p=lbData[cur];lbImg.src=p.src;lbCap.textContent=p.caption||'';}
  function open(data,idx){lbData=data;cur=((idx%data.length)+data.length)%data.length;showPhoto();lb.classList.add('open');document.body.style.overflow='hidden';}
  function close(){lb.classList.remove('open');document.body.style.overflow='';}
  document.getElementById('abLbClose').onclick=close;
  document.getElementById('abLbPrev').onclick=function(e){e.stopPropagation();cur=(cur-1+lbData.length)%lbData.length;showPhoto();};
  document.getElementById('abLbNext').onclick=function(e){e.stopPropagation();cur=(cur+1)%lbData.length;showPhoto();};
  lb.onclick=function(e){if(e.target===lb)close();};
  document.addEventListener('keydown',function(e){if(!lb.classList.contains('open'))return;if(e.key==='Escape')close();if(e.key==='ArrowLeft')document.getElementById('abLbPrev').click();if(e.key==='ArrowRight')document.getElementById('abLbNext').click();});
  document.querySelectorAll('.gt-bento-gallery').forEach(function(gal){
    var data=[];try{data=JSON.parse(gal.dataset.photos.replace(/&quot;/g,'"'));}catch(e){}
    gal.querySelectorAll('[data-lb-index]').forEach(function(tile){
      tile.onclick=function(){open(data,parseInt(tile.dataset.lbIndex,10));};
    });
  });
})();

document.querySelectorAll('.lang-btn').forEach(function(btn){
  btn.addEventListener('click',function(){
    document.querySelectorAll('.lang-btn').forEach(function(b){
      b.style.color='var(--gray-500)';b.style.borderBottomColor='transparent';
    });
    btn.style.color='var(--green)';btn.style.borderBottomColor='var(--green)';
    ['en','hi','te'].forEach(function(l){
      var el=document.getElementById('content-'+l);
      if(el) el.style.display='none';
    });
    var target=document.getElementById('content-'+btn.dataset.lang);
    if(target) target.style.display='';
  });
});
</script>
