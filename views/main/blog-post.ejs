<% extraHead = `<meta property="og:type" content="article">
<meta property="og:title" content="${post.title}">
<meta property="og:description" content="${post.excerpt || ''}">
<meta property="og:url" content="${canonicalUrl}">
<meta property="og:image" content="${ogImage}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="${post.title}">
<meta name="twitter:description" content="${post.excerpt || ''}">
<meta name="twitter:image" content="${ogImage}">` %>

<section class="page-hero" style="padding:48px 0 32px">
  <div class="container" style="max-width:820px">
    <span class="blog-cat blog-cat-<%= post.category %>" style="margin-bottom:12px;display:inline-block"><%= post.category %></span>
    <h1 style="font-size:clamp(1.5rem,4vw,2.2rem);line-height:1.2;margin-bottom:12px"><%= post.title %></h1>
    <div class="post-meta">
      <span><i class="fa fa-calendar-alt"></i> <%= new Date(post.published_at).toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'}) %></span>
      <span><i class="fa fa-eye"></i> <%= post.views %> views</span>
    </div>
    <p class="breadcrumb" style="margin-top:0"><a href="/">Home</a> <span>›</span> <a href="/blog">Blog</a> <span>›</span> <%= post.title.slice(0,40) %>…</p>
  </div>
</section>

<div class="post-layout">
  <article class="post-content">
    <% if (post.cover_image) { %>
    <img src="/uploads/blog/<%= post.cover_image %>" alt="<%= post.title %>" class="post-cover" onerror="this.style.display='none'">
    <% } %>
    <% if (post.content_hi || post.content_te) { %>
    <div style="display:flex;gap:0;border-bottom:2px solid var(--gray-200);margin-bottom:1.25rem">
      <button type="button" class="lang-btn active" data-lang="en"
        style="padding:.45rem 1rem;font-size:.82rem;font-weight:600;border:none;background:none;cursor:pointer;color:var(--green);border-bottom:2px solid var(--green);margin-bottom:-2px">English</button>
      <% if (post.content_hi) { %>
      <button type="button" class="lang-btn" data-lang="hi"
        style="padding:.45rem 1rem;font-size:.82rem;font-weight:600;border:none;background:none;cursor:pointer;color:var(--gray-500);border-bottom:2px solid transparent;margin-bottom:-2px">हिंदी</button>
      <% } %>
      <% if (post.content_te) { %>
      <button type="button" class="lang-btn" data-lang="te"
        style="padding:.45rem 1rem;font-size:.82rem;font-weight:600;border:none;background:none;cursor:pointer;color:var(--gray-500);border-bottom:2px solid transparent;margin-bottom:-2px">తెలుగు</button>
      <% } %>
    </div>
    <% } %>
    <div class="post-body" id="content-en"><%- post.content || '<p>Content coming soon.</p>' %></div>
    <% if (post.content_hi) { %>
    <div class="post-body" id="content-hi" style="display:none"><%- post.content_hi %></div>
    <% } %>
    <% if (post.content_te) { %>
    <div class="post-body" id="content-te" style="display:none"><%- post.content_te %></div>
    <% } %>

    <!-- Share -->
    <div style="margin-top:40px;padding-top:24px;border-top:1px solid var(--gray-200)">
      <p style="font-size:.875rem;font-weight:600;color:var(--navy);margin-bottom:12px">Share this post</p>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <a href="https://wa.me/?text=<%= encodeURIComponent(post.title+' — '+canonicalUrl) %>" target="_blank" style="padding:8px 16px;background:#25d366;color:#fff;border-radius:var(--radius);font-size:.85rem;font-weight:500;display:inline-flex;align-items:center;gap:6px"><i class="fab fa-whatsapp"></i> WhatsApp</a>
        <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(canonicalUrl) %>" target="_blank" style="padding:8px 16px;background:#1877f2;color:#fff;border-radius:var(--radius);font-size:.85rem;font-weight:500;display:inline-flex;align-items:center;gap:6px"><i class="fab fa-facebook-f"></i> Facebook</a>
      </div>
    </div>
  </article>

  <!-- Sidebar -->
  <aside class="post-sidebar">
    <% if (related.length > 0) { %>
    <h3>Related Posts</h3>
    <div style="display:flex;flex-direction:column;gap:16px">
      <% related.forEach(function(r) { %>
      <a href="/blog/<%= r.slug %>" style="display:flex;gap:12px;align-items:flex-start;text-decoration:none">
        <% if (r.cover_image) { %>
        <img src="/uploads/blog/<%= r.cover_image %>" alt="<%= r.title %>" style="width:72px;height:56px;object-fit:cover;border-radius:var(--radius);flex-shrink:0">
        <% } %>
        <div>
          <p style="font-size:.85rem;font-weight:600;color:var(--navy);line-height:1.4;margin-bottom:4px"><%= r.title %></p>
          <span style="font-size:.75rem;color:var(--gray-500)"><%= new Date(r.published_at).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) %></span>
        </div>
      </a>
      <% }) %>
    </div>
    <% } %>

    <div style="margin-top:32px;background:var(--navy);border-radius:var(--radius-lg);padding:24px;color:var(--white);text-align:center">
      <p style="font-size:.85rem;opacity:.75;margin-bottom:12px">Interested in Admissions?</p>
      <a href="/admissions" class="btn btn-orange" style="font-size:.85rem;padding:10px 20px">Enquire Now</a>
    </div>
  </aside>
</div>
<script>
document.querySelectorAll('.lang-btn').forEach(function(btn){
  btn.addEventListener('click',function(){
    document.querySelectorAll('.lang-btn').forEach(function(b){
      b.style.color='var(--gray-500)';b.style.borderBottomColor='transparent';
    });
    btn.style.color='var(--green)';btn.style.borderBottomColor='var(--green)';
    ['en','hi','te'].forEach(function(l){
      var el=document.getElementById('content-'+l);
      if(el) el.style.display='none';
    });
    var target=document.getElementById('content-'+btn.dataset.lang);
    if(target) target.style.display='';
  });
});
</script>
