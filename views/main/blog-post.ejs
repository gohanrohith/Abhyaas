<% extraHead = `<meta property="og:type" content="article">
<meta property="og:title" content="${post.title}">
<meta property="og:description" content="${post.excerpt || ''}">
${post.cover_image ? '<meta property="og:image" content="/uploads/blog/'+post.cover_image+'">' : ''}` %>

<section class="page-hero" style="padding:48px 0 32px">
  <div class="container" style="max-width:820px">
    <span class="blog-cat blog-cat-<%= post.category %>" style="margin-bottom:12px;display:inline-block"><%= post.category %></span>
    <h1 style="font-size:clamp(1.5rem,4vw,2.2rem);line-height:1.2;margin-bottom:12px"><%= post.title %></h1>
    <div class="post-meta">
      <span><i class="fa fa-calendar-alt"></i> <%= new Date(post.published_at).toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'}) %></span>
      <span><i class="fa fa-eye"></i> <%= post.views %> views</span>
    </div>
    <p class="breadcrumb" style="margin-top:0"><a href="/">Home</a> <span>›</span> <a href="/blog">Blog</a> <span>›</span> <%= post.title.slice(0,40) %>…</p>
  </div>
</section>

<div class="post-layout">
  <article class="post-content">
    <% if (post.cover_image) { %>
    <img src="/uploads/blog/<%= post.cover_image %>" alt="<%= post.title %>" class="post-cover">
    <% } %>
    <div class="post-body">
      <%- post.content || '<p>Content coming soon.</p>' %>
    </div>

    <!-- Share -->
    <div style="margin-top:40px;padding-top:24px;border-top:1px solid var(--gray-200)">
      <p style="font-size:.875rem;font-weight:600;color:var(--navy);margin-bottom:12px">Share this post</p>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <a href="https://wa.me/?text=<%= encodeURIComponent(post.title+' — '+canonicalUrl) %>" target="_blank" style="padding:8px 16px;background:#25d366;color:#fff;border-radius:var(--radius);font-size:.85rem;font-weight:500;display:inline-flex;align-items:center;gap:6px"><i class="fab fa-whatsapp"></i> WhatsApp</a>
        <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(canonicalUrl) %>" target="_blank" style="padding:8px 16px;background:#1877f2;color:#fff;border-radius:var(--radius);font-size:.85rem;font-weight:500;display:inline-flex;align-items:center;gap:6px"><i class="fab fa-facebook-f"></i> Facebook</a>
      </div>
    </div>
  </article>

  <!-- Sidebar -->
  <aside class="post-sidebar">
    <% if (related.length > 0) { %>
    <h3>Related Posts</h3>
    <div style="display:flex;flex-direction:column;gap:16px">
      <% related.forEach(function(r) { %>
      <a href="/blog/<%= r.slug %>" style="display:flex;gap:12px;align-items:flex-start;text-decoration:none">
        <% if (r.cover_image) { %>
        <img src="/uploads/blog/<%= r.cover_image %>" alt="<%= r.title %>" style="width:72px;height:56px;object-fit:cover;border-radius:var(--radius);flex-shrink:0">
        <% } %>
        <div>
          <p style="font-size:.85rem;font-weight:600;color:var(--navy);line-height:1.4;margin-bottom:4px"><%= r.title %></p>
          <span style="font-size:.75rem;color:var(--gray-500)"><%= new Date(r.published_at).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) %></span>
        </div>
      </a>
      <% }) %>
    </div>
    <% } %>

    <div style="margin-top:32px;background:var(--navy);border-radius:var(--radius-lg);padding:24px;color:var(--white);text-align:center">
      <p style="font-size:.85rem;opacity:.75;margin-bottom:12px">Interested in Admissions?</p>
      <a href="/admissions" class="btn btn-orange" style="font-size:.85rem;padding:10px 20px">Enquire Now</a>
    </div>
  </aside>
</div>
