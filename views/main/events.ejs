<section class="page-hero">
  <div class="container">
    <h1>Events</h1>
    <p>Upcoming and past events at Abhyaas</p>
    <p class="breadcrumb"><a href="/">Home</a> <span>›</span> Events</p>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:860px">

    <% if (upcoming.length > 0) { %>
    <div class="section-header" style="text-align:left;margin-bottom:28px">
      <span class="section-tag">Coming Up</span>
      <h2 style="color:var(--navy)">Upcoming Events</h2>
    </div>
    <div style="display:flex;flex-direction:column;gap:20px;margin-bottom:56px">
      <% upcoming.forEach(function(ev) { %>
      <div style="background:var(--white);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;display:grid;grid-template-columns:<%= ev.cover_image ? '200px' : '0' %> 1fr;border-left:4px solid var(--green)">
        <% if (ev.cover_image) { %>
        <img src="/uploads/events/<%= ev.cover_image %>" alt="<%= ev.title %>" style="width:200px;height:100%;object-fit:cover">
        <% } %>
        <div style="padding:24px">
          <div style="display:flex;gap:16px;align-items:flex-start;flex-wrap:wrap">
            <div style="background:var(--navy);color:var(--white);border-radius:var(--radius);padding:10px 16px;text-align:center;flex-shrink:0;min-width:60px">
              <span style="display:block;font-size:1.4rem;font-weight:800;line-height:1"><%= ev.event_date ? new Date(ev.event_date).getDate() : '—' %></span>
              <span style="display:block;font-size:.7rem;text-transform:uppercase;opacity:.75"><%= ev.event_date ? new Date(ev.event_date).toLocaleDateString('en-IN',{month:'short'}) : '' %></span>
            </div>
            <div style="flex:1">
              <h3 style="color:var(--navy);font-weight:700;margin-bottom:8px"><%= ev.title %></h3>
              <% if (ev.description) { %><p style="color:var(--gray-500);font-size:.9rem;margin-bottom:10px"><%= ev.description %></p><% } %>
              <div style="display:flex;gap:16px;flex-wrap:wrap">
                <% if (ev.event_time) { %><span style="font-size:.8rem;color:var(--green);display:flex;align-items:center;gap:4px"><i class="fa fa-clock"></i> <%= ev.event_time %></span><% } %>
                <% if (ev.location) { %><span style="font-size:.8rem;color:var(--gray-500);display:flex;align-items:center;gap:4px"><i class="fa fa-map-marker-alt"></i> <%= ev.location %></span><% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>

    <% if (past.length > 0) { %>
    <div class="section-header" style="text-align:left;margin-bottom:28px">
      <span class="section-tag">Past</span>
      <h2 style="color:var(--navy)">Past Events</h2>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
      <% past.forEach(function(ev) { %>
      <div style="background:var(--offwhite);border-radius:var(--radius);padding:18px;display:flex;gap:14px;align-items:flex-start">
        <div style="background:var(--gray-200);color:var(--gray-700);border-radius:var(--radius);padding:8px 12px;text-align:center;flex-shrink:0">
          <span style="display:block;font-size:1.1rem;font-weight:700;line-height:1"><%= ev.event_date ? new Date(ev.event_date).getDate() : '—' %></span>
          <span style="display:block;font-size:.65rem;text-transform:uppercase"><%= ev.event_date ? new Date(ev.event_date).toLocaleDateString('en-IN',{month:'short',year:'numeric'}) : '' %></span>
        </div>
        <div>
          <h4 style="color:var(--navy);font-weight:600;font-size:.9rem"><%= ev.title %></h4>
          <% if (ev.location) { %><p style="font-size:.78rem;color:var(--gray-500);margin-top:3px"><i class="fa fa-map-marker-alt"></i> <%= ev.location %></p><% } %>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>

    <% if (upcoming.length === 0 && past.length === 0) { %>
    <div style="text-align:center;padding:80px 0;color:var(--gray-500)">
      <i class="fa fa-calendar-xmark" style="font-size:3rem;opacity:.2;display:block;margin-bottom:16px"></i>
      <p>No events scheduled yet. Check back soon!</p>
    </div>
    <% } %>
  </div>
</section>
