<section class="page-hero">
  <div class="container">
    <h1>Photo Gallery</h1>
    <p>Glimpses of life at Abhyaas The Global School</p>
    <p class="breadcrumb"><a href="/">Home</a> <span>›</span> Gallery</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <% if (albums.length > 0) { %>
    <div class="albums-grid">
      <% albums.forEach(function(album) { %>
      <a href="/gallery/<%= album.slug %>" class="gallery-album-card">
        <div class="album-thumb">
          <% if (album.cover_image) { %>
          <img src="/uploads/gallery/<%= album.cover_image %>" alt="<%= album.title %>" loading="lazy">
          <% } else if (album.first_photo) { %>
          <img src="/uploads/gallery/<%= album.first_photo %>" alt="<%= album.title %>" loading="lazy">
          <% } else { %>
          <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center">
            <i class="fa fa-images" style="font-size:2.5rem;color:rgba(255,255,255,.3)"></i>
          </div>
          <% } %>
        </div>
        <div class="album-info">
          <h3 style="color:var(--navy);font-weight:700;font-size:.95rem;margin-bottom:4px"><%= album.title %></h3>
          <% if (album.description) { %><p style="color:var(--gray-500);font-size:.8rem"><%= album.description.slice(0,60) %>…</p><% } %>
        </div>
      </a>
      <% }) %>
    </div>
    <% } else { %>
    <div style="text-align:center;padding:80px 0;color:var(--gray-500)">
      <i class="fa fa-images" style="font-size:3rem;opacity:.2;display:block;margin-bottom:16px"></i>
      <p>Gallery albums will be added soon. Check back!</p>
    </div>
    <% } %>
  </div>
</section>
