<section class="page-hero">
  <div class="container">
    <h1>Contact Us</h1>
    <p>We'd love to hear from you</p>
    <p class="breadcrumb"><a href="/">Home</a> <span>›</span> Contact</p>
  </div>
</section>

<section class="section">
  <div class="container" style="display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:flex-start">

    <!-- Contact info -->
    <div>
      <span class="section-tag">Get in Touch</span>
      <h2 style="color:var(--navy);margin:12px 0 24px">We're Here to Help</h2>
      <div style="display:flex;flex-direction:column;gap:20px;margin-bottom:40px">
        <% if (school.address) { %>
        <div style="display:flex;gap:16px;align-items:flex-start">
          <div style="width:44px;height:44px;background:var(--green-10);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <i class="fa fa-map-marker-alt" style="color:var(--green)"></i>
          </div>
          <div>
            <strong style="color:var(--navy);display:block;margin-bottom:4px">Address</strong>
            <span style="color:var(--gray-500);font-size:.9rem"><%= school.address %></span>
          </div>
        </div>
        <% } %>
        <% if (school.phone) { %>
        <div style="display:flex;gap:16px;align-items:flex-start">
          <div style="width:44px;height:44px;background:var(--green-10);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <i class="fa fa-phone" style="color:var(--green)"></i>
          </div>
          <div>
            <strong style="color:var(--navy);display:block;margin-bottom:4px">Phone</strong>
            <a href="tel:<%= school.phone %>" style="color:var(--gray-500);font-size:.9rem"><%= school.phone %></a>
          </div>
        </div>
        <% } %>
        <% if (school.whatsapp) { %>
        <div style="display:flex;gap:16px;align-items:flex-start">
          <div style="width:44px;height:44px;background:rgba(37,211,102,.12);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <i class="fab fa-whatsapp" style="color:#25d366"></i>
          </div>
          <div>
            <strong style="color:var(--navy);display:block;margin-bottom:4px">WhatsApp</strong>
            <a href="https://wa.me/<%= school.whatsapp.replace(/\D/g,'') %>" target="_blank" style="color:var(--gray-500);font-size:.9rem"><%= school.whatsapp %></a>
          </div>
        </div>
        <% } %>
        <div style="display:flex;gap:16px;align-items:flex-start">
          <div style="width:44px;height:44px;background:var(--green-10);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <i class="fa fa-envelope" style="color:var(--green)"></i>
          </div>
          <div>
            <strong style="color:var(--navy);display:block;margin-bottom:4px">Email</strong>
            <a href="mailto:<%= school.email %>" style="color:var(--gray-500);font-size:.9rem"><%= school.email %></a>
          </div>
        </div>
        <div style="display:flex;gap:16px;align-items:flex-start">
          <div style="width:44px;height:44px;background:var(--green-10);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <i class="fa fa-clock" style="color:var(--green)"></i>
          </div>
          <div>
            <strong style="color:var(--navy);display:block;margin-bottom:4px">School Hours</strong>
            <span style="color:var(--gray-500);font-size:.9rem">Monday – Saturday: 8:30 AM – 4:30 PM</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Contact form -->
    <div style="background:var(--white);border-radius:var(--radius-lg);box-shadow:var(--shadow-lg);padding:36px">
      <h3 style="color:var(--navy);margin-bottom:20px">Send a Message</h3>

      <% if (success) { %>
      <div class="alert alert-success"><i class="fa fa-check-circle"></i> Message sent! We'll get back to you soon.</div>
      <% } %>
      <% if (error) { %>
      <div class="alert alert-error"><i class="fa fa-exclamation-circle"></i> <%= error %></div>
      <% } %>

      <% if (!success) { %>
      <form action="/contact" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-row">
          <div class="form-group">
            <label>Name *</label>
            <input type="text" name="name" class="form-control" required>
          </div>
          <div class="form-group">
            <label>Phone *</label>
            <input type="tel" name="phone" class="form-control" required>
          </div>
        </div>
        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" class="form-control">
        </div>
        <div class="form-group">
          <label>Subject</label>
          <input type="text" name="subject" class="form-control" value="<%= typeof query !== 'undefined' && query.subject ? query.subject : '' %>">
        </div>
        <div class="form-group">
          <label>Message *</label>
          <textarea name="message" class="form-control" rows="5" required></textarea>
        </div>
        <button type="submit" class="btn btn-green" style="width:100%">Send Message</button>
      </form>
      <% } %>
    </div>

  </div>
</section>
