<div class="page-header">
  <h1><i class="fa fa-gear" style="color:var(--green);margin-right:8px"></i> Settings</h1>
</div>

<% if (success) { %><div class="alert alert-success" data-auto-dismiss><i class="fa fa-check-circle"></i> Settings saved successfully.</div><% } %>
<% if (error)   { %><div class="alert alert-error"><i class="fa fa-circle-exclamation"></i> <%= error %></div><% } %>

<form action="/admin/settings" method="POST">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start">

    <!-- General settings -->
    <div class="card">
      <div class="card-header"><h3><i class="fa fa-sliders" style="color:var(--green)"></i> General</h3></div>
      <div class="card-body" style="display:flex;flex-direction:column;gap:18px">
        <div class="form-group">
          <label for="admission_year">Admission Year</label>
          <input type="text" id="admission_year" name="admission_year"
                 value="<%= settings.admission_year || '2025-26' %>"
                 placeholder="e.g. 2025-26">
        </div>
        <div class="form-group">
          <label for="phone">Contact Phone</label>
          <input type="text" id="phone" name="phone"
                 value="<%= settings.phone || '' %>"
                 placeholder="+91 99999 99999">
          <span class="form-hint">Shown in header/footer. Overrides config/school.js value.</span>
        </div>
        <div class="form-group">
          <label for="whatsapp">WhatsApp Number</label>
          <input type="text" id="whatsapp" name="whatsapp"
                 value="<%= settings.whatsapp || '' %>"
                 placeholder="91XXXXXXXXXX (with country code, no +)">
          <span class="form-hint">Used for the WhatsApp float button.</span>
        </div>
        <div>
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer">
            <input type="checkbox" id="admissions_open" name="admissions_open" value="1"
                   <%= settings.admissions_open === '1' ? 'checked' : '' %>
                   style="width:18px;height:18px">
            <span style="font-weight:600">Admissions Open</span>
          </label>
          <p class="form-hint" style="margin-top:4px;margin-left:28px">When checked, shows the "Admissions Open" band on the homepage.</p>
        </div>
      </div>
    </div>

    <!-- Change password -->
    <div class="card">
      <div class="card-header"><h3><i class="fa fa-key" style="color:var(--orange)"></i> Change Password</h3></div>
      <div class="card-body" style="display:flex;flex-direction:column;gap:18px">
        <div class="alert alert-info" style="font-size:.82rem"><i class="fa fa-info-circle"></i> Leave these fields blank to keep your current password.</div>
        <div class="form-group">
          <label for="current_password">Current Password</label>
          <input type="password" id="current_password" name="current_password"
                 autocomplete="current-password" placeholder="Enter current password">
        </div>
        <div class="form-group">
          <label for="new_password">New Password</label>
          <input type="password" id="new_password" name="new_password"
                 autocomplete="new-password" placeholder="Minimum 8 characters">
        </div>
        <div class="form-group">
          <label for="confirm_password">Confirm New Password</label>
          <input type="password" id="confirm_password" name="confirm_password"
                 autocomplete="new-password" placeholder="Repeat new password">
        </div>
      </div>
    </div>

  </div>

  <div style="margin-top:20px">
    <button type="submit" class="btn btn-green"><i class="fa fa-save"></i> Save Settings</button>
  </div>
</form>
