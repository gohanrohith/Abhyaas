<div class="page-header">
  <h1><i class="fa fa-plus" style="color:var(--green);margin-right:8px"></i> New Album</h1>
  <a href="/admin/gallery" class="btn btn-outline"><i class="fa fa-arrow-left"></i> Back</a>
</div>

<% if (error) { %><div class="alert alert-error"><i class="fa fa-circle-exclamation"></i> <%= error %></div><% } %>

<div class="card" style="max-width:560px">
  <div class="card-body">
    <form action="/admin/gallery/album/create" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group" style="margin-bottom:18px">
        <label for="title">Album Title <span class="req">*</span></label>
        <input type="text" id="title" name="title" required
               value="<%= (album && album.title) ? album.title : '' %>"
               placeholder="e.g. Annual Day 2025">
      </div>
      <div class="form-group" style="margin-bottom:18px">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="3"
                  placeholder="Brief description of this album"><%= (album && album.description) ? album.description : '' %></textarea>
      </div>
      <div class="form-group" style="margin-bottom:24px">
        <label>Cover Image</label>
        <input type="file" name="image" accept="image/*">
        <span class="form-hint">Optional. JPEG, PNG, WebP. Max 5 MB.</span>
      </div>
      <div style="display:flex;gap:10px">
        <button type="submit" class="btn btn-green"><i class="fa fa-save"></i> Create Album</button>
        <a href="/admin/gallery" class="btn btn-outline">Cancel</a>
      </div>
    </form>
  </div>
</div>
