<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.snow.min.css">
<style>
.lang-tabs { display:flex; gap:0; border-bottom:2px solid #e5e7eb; margin-bottom:0; }
.lang-tab  { padding:.45rem 1.1rem; font-size:.82rem; font-weight:600; border:none; background:none; cursor:pointer; color:#888; border-bottom:2px solid transparent; margin-bottom:-2px; transition:all .15s; }
.lang-tab.active { color:var(--green); border-bottom-color:var(--green); }
.lang-panel { display:none; }
.lang-panel.active { display:block; }
#wordCountBar { padding:.3rem .6rem; border-top:1px solid #e5e7eb; background:#f9fafb; font-size:.75rem; display:flex; align-items:center; gap:.5rem; }
</style>

<div class="page-header">
  <h1><i class="fa fa-<%= post && post.id ? 'pen' : 'plus' %>" style="color:var(--green);margin-right:8px"></i>
    <%= post && post.id ? 'Edit Post' : 'New Post' %></h1>
  <a href="/admin/blog" class="btn btn-outline"><i class="fa fa-arrow-left"></i> Back</a>
</div>

<% if (error) { %><div class="alert alert-error"><i class="fa fa-circle-exclamation"></i> <%= error %></div><% } %>

<form action="<%= post && post.id ? `/admin/blog/${post.id}/update` : '/admin/blog/create' %>"
      method="POST" enctype="multipart/form-data" id="blogForm">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div style="display:grid;grid-template-columns:1fr 320px;gap:24px;align-items:start">

    <!-- Main column -->
    <div>
      <div class="card">
        <div class="card-body">
          <div class="form-group" style="margin-bottom:20px">
            <label for="title">Title <span class="req">*</span></label>
            <input type="text" id="title" name="title" required
                   value="<%= (post && post.title) ? post.title : '' %>"
                   placeholder="Post title"
                   oninput="autoSlug(this.value)">
          </div>
          <div class="form-group" style="margin-bottom:20px">
            <label for="excerpt">Excerpt</label>
            <textarea id="excerpt" name="excerpt" rows="3"
                      placeholder="Short description (shown in listing)"><%= (post && post.excerpt) ? post.excerpt : '' %></textarea>
          </div>

          <!-- Trilingual Quill tabs -->
          <div class="form-group">
            <label>Content</label>
            <div style="border:1px solid #d1d5db;border-radius:6px;overflow:hidden">
              <div class="lang-tabs">
                <button type="button" class="lang-tab active" data-target="tab-en">English</button>
                <button type="button" class="lang-tab" data-target="tab-hi">हिंदी</button>
                <button type="button" class="lang-tab" data-target="tab-te">తెలుగు</button>
              </div>
              <div id="tab-en" class="lang-panel active">
                <div id="quillEn" style="min-height:320px;background:#fff"><%- (post && post.content) ? post.content : '' %></div>
                <div id="wordCountBar">
                  <span style="color:#888">Words:</span>
                  <span id="wordCountNum" style="font-weight:700;color:#888">0</span>
                  <span id="wordCountMsg" style="margin-left:.25rem"></span>
                </div>
              </div>
              <div id="tab-hi" class="lang-panel">
                <div id="quillHi" style="min-height:320px;background:#fff"><%- (post && post.content_hi) ? post.content_hi : '' %></div>
              </div>
              <div id="tab-te" class="lang-panel">
                <div id="quillTe" style="min-height:320px;background:#fff"><%- (post && post.content_te) ? post.content_te : '' %></div>
              </div>
            </div>
            <input type="hidden" name="content"    id="inputEn">
            <input type="hidden" name="content_hi" id="inputHi">
            <input type="hidden" name="content_te" id="inputTe">
            <div style="padding:.45rem 1rem;background:#f9fafb;border-top:1px solid #d1d5db">
              <button type="button" onclick="openGalleryPicker()" style="font-size:.78rem;padding:.3rem .8rem;background:var(--green);color:#fff;border:none;border-radius:4px;cursor:pointer"><i class="fa fa-images"></i> Insert Gallery Album</button>
            </div>
          </div>

          <!-- Custom slug -->
          <div class="form-group" style="margin-top:20px">
            <label>Custom URL slug <span style="font-weight:400;color:#888;font-size:.82em">(optional)</span></label>
            <input type="text" name="custom_slug" id="slugInput"
                   value="<%= (post && post.slug) ? post.slug : '' %>"
                   placeholder="e.g. annual-sports-day-2025"
                   pattern="[a-z0-9\-]+"
                   style="text-transform:lowercase"
                   oninput="this.value=this.value.toLowerCase().replace(/[^a-z0-9-]/g,'-').replace(/-{2,}/g,'-')">
            <span class="form-hint">abhyaastheglobalschool.com/blog/<span id="slugPreview" style="color:var(--green);font-weight:600"><%= (post && post.slug) ? post.slug : '&lt;auto&gt;' %></span></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar column -->
    <div>
      <!-- Publish -->
      <div class="card" style="margin-bottom:16px">
        <div class="card-header"><h3>Publish</h3></div>
        <div class="card-body" style="display:flex;flex-direction:column;gap:12px">
          <div class="form-group">
            <label for="status">Status</label>
            <select id="status" name="status">
              <option value="draft"     <%= (post && post.status === 'draft')     ? 'selected' : '' %>>Draft</option>
              <option value="published" <%= (post && post.status === 'published') ? 'selected' : '' %>>Published</option>
            </select>
          </div>
          <div class="form-check">
            <input type="checkbox" id="featured" name="featured" value="1"
                   <%= (post && post.featured) ? 'checked' : '' %>>
            <label for="featured">Featured post</label>
          </div>
          <button type="submit" class="btn btn-green" style="width:100%;justify-content:center">
            <i class="fa fa-save"></i> <%= post && post.id ? 'Update Post' : 'Create Post' %>
          </button>
        </div>
      </div>

      <!-- Category -->
      <div class="card" style="margin-bottom:16px">
        <div class="card-header"><h3>Category</h3></div>
        <div class="card-body">
          <div class="form-group">
            <select name="category">
              <option value="news"        <%= (post && post.category === 'news')        ? 'selected' : '' %>>News & Announcements</option>
              <option value="article"     <%= (post && post.category === 'article')     ? 'selected' : '' %>>Articles / Editorial</option>
              <option value="achievement" <%= (post && post.category === 'achievement') ? 'selected' : '' %>>Student Achievements</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Cover image -->
      <div class="card">
        <div class="card-header"><h3>Cover Image</h3></div>
        <div class="card-body">
          <% if (post && post.cover_image) { %>
          <img src="/uploads/blog/<%= post.cover_image %>" alt="Cover"
               style="width:100%;border-radius:var(--radius);margin-bottom:12px;object-fit:cover;height:160px">
          <% } %>
          <div class="form-group">
            <label for="image">
              <%= (post && post.cover_image) ? 'Replace image' : 'Upload cover image' %>
            </label>
            <input type="file" id="image" name="image" accept="image/*">
            <span class="form-hint">JPEG, PNG, WebP. Max 5 MB.</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</form>

<script src="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.min.js"></script>
<script>
['tab-hi','tab-te'].forEach(function(id){
  var el=document.getElementById(id);
  el.style.cssText='display:block;position:absolute;visibility:hidden;pointer-events:none';
});

var toolbarOptions=[
  [{header:[2,3,false]}],
  ['bold','italic','underline'],
  [{list:'ordered'},{list:'bullet'}],
  ['blockquote','link','image'],
  ['clean']
];

var quillEn=new Quill('#quillEn',{theme:'snow',modules:{toolbar:toolbarOptions}});
var quillHi=new Quill('#quillHi',{theme:'snow',modules:{toolbar:toolbarOptions}});
var quillTe=new Quill('#quillTe',{theme:'snow',modules:{toolbar:toolbarOptions}});

// Track active editor
var activeQuill=quillEn;
document.querySelectorAll('.lang-tab').forEach(function(btn){
  btn.addEventListener('click',function(){
    var t=btn.dataset.target;
    activeQuill= t==='tab-en'?quillEn: t==='tab-hi'?quillHi:quillTe;
  });
});

['tab-hi','tab-te'].forEach(function(id){
  document.getElementById(id).style.cssText='display:none';
});

document.querySelectorAll('.lang-tab').forEach(function(btn){
  btn.addEventListener('click',function(){
    document.querySelectorAll('.lang-tab').forEach(function(b){b.classList.remove('active');});
    document.querySelectorAll('.lang-panel').forEach(function(p){p.style.display='none';});
    btn.classList.add('active');
    document.getElementById(btn.dataset.target).style.display='block';
  });
});

document.getElementById('blogForm').addEventListener('submit',function(){
  document.getElementById('inputEn').value=quillEn.root.innerHTML;
  document.getElementById('inputHi').value=quillHi.root.innerHTML;
  document.getElementById('inputTe').value=quillTe.root.innerHTML;
});

var WORD_MAX=500;
function countWords(text){return text.trim()===''?0:text.trim().split(/\s+/).length;}
function updateWordCount(){
  var text=quillEn.getText();
  var count=countWords(text);
  var numEl=document.getElementById('wordCountNum');
  var msgEl=document.getElementById('wordCountMsg');
  var bar  =document.getElementById('wordCountBar');
  numEl.textContent=count;
  if(count>=WORD_MAX){
    numEl.style.color='#e63946';bar.style.borderTop='2px solid #e63946';
    msgEl.textContent='Word limit reached — please trim the post.';msgEl.style.color='#e63946';
  } else if(count>=400){
    numEl.style.color='#e67e22';bar.style.borderTop='2px solid #e67e22';
    msgEl.textContent='Getting long — ideal length is under 400 words.';msgEl.style.color='#e67e22';
  } else if(count>=300){
    numEl.style.color='var(--green)';bar.style.borderTop='2px solid var(--green)';
    msgEl.textContent='Good length.';msgEl.style.color='var(--green)';
  } else {
    numEl.style.color='#888';bar.style.borderTop='1px solid #e5e7eb';msgEl.textContent='';
  }
}
quillEn.on('text-change',updateWordCount);
updateWordCount();

function slugify(s){return s.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');}
function autoSlug(val){
  var si=document.getElementById('slugInput');
  if(!si._manuallyEdited){si.value=slugify(val);updateSlugPreview(si.value);}
}
document.getElementById('slugInput').addEventListener('input',function(){
  this._manuallyEdited=!!this.value;
  updateSlugPreview(this.value);
});
function updateSlugPreview(v){document.getElementById('slugPreview').textContent=v||'<auto>';}
</script>

<!-- Gallery picker modal -->
<div id="galleryModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:2000;align-items:center;justify-content:center">
  <div style="background:#fff;border-radius:10px;max-width:620px;width:92%;max-height:80vh;display:flex;flex-direction:column;box-shadow:0 16px 48px rgba(0,0,0,.25)">
    <div style="display:flex;align-items:center;justify-content:space-between;padding:1rem 1.25rem;border-bottom:1px solid #e5e7eb">
      <h3 style="font-size:.95rem;font-weight:700;margin:0">Select Gallery Album</h3>
      <button id="galleryModalClose" type="button" style="background:none;border:none;font-size:1.2rem;cursor:pointer;color:#888">&times;</button>
    </div>
    <div id="galleryAlbumList" style="padding:1rem;overflow-y:auto;flex:1;display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:.75rem">
      <p style="color:#888;font-size:.85rem;grid-column:1/-1">Loading…</p>
    </div>
  </div>
</div>
<script>
(function(){
  var modal=document.getElementById('galleryModal');
  document.getElementById('galleryModalClose').onclick=function(){modal.style.display='none';};
  modal.onclick=function(e){if(e.target===modal)modal.style.display='none';};
  var loaded=false;
  window.openGalleryPicker=function(){
    modal.style.display='flex';
    if(loaded) return;
    loaded=true;
    fetch('/admin/gallery/albums-json')
      .then(function(r){return r.json();})
      .then(function(albums){
        var list=document.getElementById('galleryAlbumList');
        if(!albums.length){list.innerHTML='<p style="color:#888;font-size:.85rem;grid-column:1/-1">No albums yet. Create one in Gallery first.</p>';return;}
        list.innerHTML='';
        albums.forEach(function(a){
          var el=document.createElement('div');
          el.style.cssText='border:2px solid #e5e7eb;border-radius:6px;overflow:hidden;cursor:pointer';
          el.innerHTML='<img src="'+(a.cover||'/images/logo-abhyaas.png')+'" style="width:100%;aspect-ratio:4/3;object-fit:cover;display:block" onerror="this.src=\'/images/logo-abhyaas.png\'">'
            +'<div style="padding:.4rem .5rem;font-size:.76rem;font-weight:600">'+a.title+'</div>';
          el.onclick=function(){
            var range=activeQuill.getSelection(true);
            activeQuill.clipboard.dangerouslyPasteHTML(range.index,'<figure class="inline-gallery" data-album="'+a.id+'"><span>Gallery: '+a.title+'</span></figure>');
            activeQuill.setSelection(range.index+1);
            modal.style.display='none';
          };
          list.appendChild(el);
        });
      })
      .catch(function(){document.getElementById('galleryAlbumList').innerHTML='<p style="color:#888;font-size:.85rem">Error loading albums.</p>';});
  };
})();
</script>
