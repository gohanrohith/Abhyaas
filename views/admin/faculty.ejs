<div class="page-header">
  <h1><i class="fa fa-chalkboard-teacher" style="color:var(--green);margin-right:8px"></i> Faculty</h1>
</div>

<% if (error) { %><div class="alert alert-error"><i class="fa fa-circle-exclamation"></i> <%= error %></div><% } %>

<!-- Add faculty form -->
<div class="card" style="margin-bottom:24px">
  <div class="card-header"><h3><i class="fa fa-plus" style="color:var(--green)"></i> Add Faculty Member</h3></div>
  <div class="card-body">
    <form action="/admin/faculty/create" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-grid">
        <div class="form-group">
          <label for="name">Name <span class="req">*</span></label>
          <input type="text" id="name" name="name" required placeholder="Full name">
        </div>
        <div class="form-group">
          <label for="designation">Designation <span class="req">*</span></label>
          <input type="text" id="designation" name="designation" required placeholder="e.g. Senior Teacher">
        </div>
        <div class="form-group">
          <label for="subject">Subject</label>
          <input type="text" id="subject" name="subject" placeholder="e.g. Mathematics">
        </div>
        <div class="form-group">
          <label for="qualification">Qualification</label>
          <input type="text" id="qualification" name="qualification" placeholder="e.g. M.Sc., B.Ed.">
        </div>
        <div class="form-group">
          <label for="experience">Experience</label>
          <input type="text" id="experience" name="experience" placeholder="e.g. 8 years">
        </div>
        <div class="form-group">
          <label for="sort_order">Sort Order</label>
          <input type="number" id="sort_order" name="sort_order" value="0" min="0">
        </div>
        <div class="form-group full">
          <label>Photo</label>
          <input type="file" name="image" accept="image/*">
          <span class="form-hint">JPEG, PNG, WebP. Max 5 MB. Square photo recommended.</span>
        </div>
      </div>
      <button type="submit" class="btn btn-green" style="margin-top:8px"><i class="fa fa-plus"></i> Add Faculty</button>
    </form>
  </div>
</div>

<!-- Faculty list -->
<div class="card">
  <div class="card-header"><h3>Current Faculty (<%= faculty.length %>)</h3></div>
  <div class="table-wrap">
    <% if (faculty.length > 0) { %>
    <table>
      <thead><tr><th>Photo</th><th>Name</th><th>Designation</th><th>Subject</th><th>Qualification</th><th>Experience</th><th>Order</th><th></th></tr></thead>
      <tbody>
      <% faculty.forEach(function(f) { %>
      <tr>
        <td>
          <% if (f.photo) { %>
          <img src="/uploads/faculty/<%= f.photo %>" alt="<%= f.name %>"
               style="width:42px;height:42px;border-radius:50%;object-fit:cover;border:2px solid var(--border)">
          <% } else { %>
          <div style="width:42px;height:42px;border-radius:50%;background:var(--offwhite);display:flex;align-items:center;justify-content:center;color:var(--gray-300)"><i class="fa fa-user"></i></div>
          <% } %>
        </td>
        <td style="font-weight:600;color:var(--navy)"><%= f.name %></td>
        <td><%= f.designation %></td>
        <td style="color:var(--gray-500)"><%= f.subject || '—' %></td>
        <td style="color:var(--gray-500)"><%= f.qualification || '—' %></td>
        <td style="color:var(--gray-500)"><%= f.experience || '—' %></td>
        <td><%= f.sort_order %></td>
        <td>
          <form action="/admin/faculty/<%= f.id %>/delete" method="POST" style="display:inline"
                data-confirm="Remove <%= f.name %>?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-danger btn-xs"><i class="fa fa-trash"></i></button>
          </form>
        </td>
      </tr>
      <% }) %>
      </tbody>
    </table>
    <% } else { %>
    <table><tbody><tr class="empty-row"><td colspan="8">No faculty members yet. Add one above.</td></tr></tbody></table>
    <% } %>
  </div>
</div>
