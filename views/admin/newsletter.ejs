<div class="page-header">
  <h1><i class="fa fa-envelope" style="color:var(--green);margin-right:8px"></i> Newsletter Subscribers</h1>
  <span style="color:var(--gray-500);font-size:.85rem"><%= subscribers.length %> subscriber<%= subscribers.length !== 1 ? 's' : '' %></span>
</div>

<div class="card">
  <div class="table-wrap">
    <% if (subscribers.length > 0) { %>
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Email</th>
          <th>Name</th>
          <th>Subscribed</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
      <% subscribers.forEach(function(s, i) { %>
      <tr>
        <td style="color:var(--gray-500);width:40px"><%= i + 1 %></td>
        <td style="font-weight:600;color:var(--navy)">
          <a href="mailto:<%= s.email %>" style="color:var(--navy)"><%= s.email %></a>
        </td>
        <td style="color:var(--gray-700)"><%= s.name || '—' %></td>
        <td style="font-size:.8rem;color:var(--gray-500)">
          <%= new Date(s.created_at).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %>
        </td>
        <td>
          <form action="/admin/newsletter/<%= s.id %>/delete" method="POST" style="display:inline"
                data-confirm="Remove <%= s.email %> from the list?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-danger btn-xs"><i class="fa fa-trash"></i></button>
          </form>
        </td>
      </tr>
      <% }) %>
      </tbody>
    </table>
    <% } else { %>
    <table><tbody><tr class="empty-row"><td colspan="5"><i class="fa fa-envelope" style="font-size:2rem;display:block;margin-bottom:8px;opacity:.2"></i>No subscribers yet.</td></tr></tbody></table>
    <% } %>
  </div>
</div>
